# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# Подключение к базе. Пароль придумать длинный, он нигде не набирается руками.
DATABASE_URL=postgres://progress:ПАРОЛЬ@localhost:5432/progress

# Пропуск. Сгенерировать так:  openssl rand -base64 36
# Он же вводится в приложении, в меню, раздел «Сервер».
SYNC_TOKEN=

# Откуда разрешено обращаться. Точный адрес приложения, без косой черты в конце.
# Несколько адресов — через запятую.
ALLOWED_ORIGIN=https://swedenbug.github.io

# Порт, который слушает служба. Наружу он не смотрит — только обратный прокси.
PORT=8787
